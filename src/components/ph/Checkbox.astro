---
import type { HTMLAttributes } from "astro/types";
import "./checkbox.css";

type Props = Omit<HTMLAttributes<"input">, "type">;

const { class: className, ...rest } = Astro.props;
---

<label class:list={["inline-flex cursor-pointer items-center gap-2 leading-[1.35]", className]}>
  <input type="checkbox" class="ph-checkbox" {...rest} />
  <slot />
</label>
