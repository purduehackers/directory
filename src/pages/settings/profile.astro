---
import Layout from "../../layouts/Layout.astro";
import BackLink from "../../components/ph/BackLink.astro";
import Field from "../../components/ph/Field.astro";
import Input from "../../components/ph/Input.astro";
import Textarea from "../../components/ph/Textarea.astro";
import Button from "../../components/ph/Button.astro";
import Separator from "../../components/ph/Separator.astro";
import Select from "../../components/ph/Select.astro";
import Checkbox from "../../components/ph/Checkbox.astro";
import Badge from "../../components/ph/Badge.astro";
import Icon from "../../components/ph/Icon.astro";
import { config } from "../../lib/server/config";
import {
    getMemberProfileBySub,
    upsertMemberProfile,
} from "../../lib/server/profile-store";
import {
    ensureMemberActive,
    refreshDirectorySnapshotProfiles,
    getDirectorySnapshot,
    getRawMemberBySub,
    isEmailVisible,
    isPhoneVisible,
    type DirectoryMemberEmail,
} from "../../lib/server/id-directory";
import { formatPhone } from "../../lib/phone";
import { validateProfileInput, sanitizeHttpUrl } from "../../lib/server/profile-validation";
import { isSameOrigin, checkRateLimit, readBodyWithLimit } from "../api/profile";

const SOCIAL_PLATFORMS = [
    { id: "github", label: "GitHub", placeholder: "@username or full URL" },
    { id: "x", label: "X (Twitter)", placeholder: "@handle or full URL" },
    {
        id: "bluesky",
        label: "Bluesky",
        placeholder: "user.bsky.social or full URL",
    },
    { id: "youtube", label: "YouTube", placeholder: "@channel or full URL" },
    { id: "instagram", label: "Instagram", placeholder: "@handle or full URL" },
    {
        id: "linkedin",
        label: "LinkedIn",
        placeholder: "in/username or full URL",
    },
    {
        id: "mastodon",
        label: "Mastodon",
        placeholder: "https://instance/@user or @user@instance",
    },
] as const;

const user = Astro.locals.user;
if (!user?.sub) {
    return Astro.redirect("/login");
}

const snapshot = await getDirectorySnapshot().catch(() => null);
const member = snapshot?.bySub.get(user.sub.toLowerCase()) ?? null;
const rawMember = getRawMemberBySub(user.sub) ?? member;
const safeUserAvatarUrl = user.picture
    ? sanitizeHttpUrl(user.picture, !config.isProduction).url
    : null;
const memberEmails: DirectoryMemberEmail[] =
    rawMember?.emails && rawMember.emails.length > 0
        ? rawMember.emails
        : rawMember?.email
          ? [
                {
                    email: rawMember.email,
                    primary: true,
                    verified: rawMember.email_verified,
                },
            ]
          : user.email
            ? [{ email: user.email, primary: true, verified: true }]
            : [];
const memberPhone = rawMember?.phone_number || null;

let profile = await getMemberProfileBySub(user.sub);
let formError = "";
let formSuccess = "";
let fieldErrors: Record<string, string> = {};

if (Astro.request.method === "POST") {
    try {
        if (!isSameOrigin(Astro.request, Astro.url)) {
            formError = "Invalid request origin (CSRF verification failed).";
        } else if (!checkRateLimit(user.sub)) {
            formError = "Too many profile updates. Please wait a moment.";
        } else if ((await ensureMemberActive(user.sub)) === false) {
            formError = "Account suspended.";
        } else {
            let rawBody = "";
            try {
                rawBody = await readBodyWithLimit(Astro.request, 16384);
            } catch (err: any) {
                if (err?.message === "PAYLOAD_TOO_LARGE") {
                    formError = "Payload too large (max 16KB).";
                } else {
                    formError = "Failed to process form submission.";
                }
            }

            if (!formError) {
                const formData = new URLSearchParams(rawBody);
                const headline = formData.get("headline")?.toString() || "";
                const major = formData.get("major")?.toString() || "";
                const bio = formData.get("bio")?.toString() || "";
                const location = formData.get("location")?.toString() || "";
                const timezone = formData.get("timezone")?.toString() || "";
                const websiteUrl = formData.get("websiteUrl")?.toString() || "";

                const socials: Record<string, string> = {
                    github: formData.get("social_github")?.toString() || "",
                    x: formData.get("social_x")?.toString() || "",
                    linkedin: formData.get("social_linkedin")?.toString() || "",
                    instagram:
                        formData.get("social_instagram")?.toString() || "",
                    youtube: formData.get("social_youtube")?.toString() || "",
                    bluesky: formData.get("social_bluesky")?.toString() || "",
                    mastodon: formData.get("social_mastodon")?.toString() || "",
                };

                const socialPlatforms = formData.getAll("social_platform");
                const socialValues = formData.getAll("social_value");
                socialPlatforms.forEach((p, idx) => {
                    const plat = p.toString().trim();
                    const val = (socialValues[idx] || "").toString().trim();
                    if (plat in socials) {
                        socials[plat] = val;
                    }
                });

                const customLinkLabels = formData.getAll("custom_label");
                const customLinkUrls = formData.getAll("custom_url");
                const customLinks = customLinkLabels
                    .map((lbl, idx) => ({
                        label: lbl.toString(),
                        url: (customLinkUrls[idx] || "").toString(),
                    }))
                    .filter((l) => l.label.trim() || l.url.trim());

                const submittedVisibleEmails = new Set(
                    formData
                        .getAll("visible_email")
                        .map((e) => e.toString().toLowerCase().trim()),
                );
                const emailsVisibility: Record<string, boolean> = {
                    ...(profile?.contactVisibility?.emails ?? {}),
                };
                for (const em of memberEmails) {
                    const key = em.email.toLowerCase().trim();
                    emailsVisibility[key] = submittedVisibleEmails.has(key);
                }

                const contactVisibility = {
                    emails: emailsVisibility,
                    phone: memberPhone
                        ? formData.has("visible_phone")
                        : (profile?.contactVisibility?.phone ?? false),
                };

                const validation = validateProfileInput({
                    headline,
                    major,
                    bio,
                    location,
                    timezone,
                    websiteUrl,
                    socials,
                    customLinks,
                    contactVisibility,
                });

                if (!validation.ok) {
                    formError = "Please correct the highlighted fields.";
                    fieldErrors = validation.errors;
                    // Preserve edits on validation failure so user doesn't lose inputs
                    profile = {
                        sub: user.sub,
                        headline: headline || null,
                        major: major || null,
                        bio: bio || null,
                        location: location || null,
                        timezone: timezone || null,
                        websiteUrl: websiteUrl || null,
                        socials: {
                            ...profile?.socials,
                            ...socials,
                        },
                        customLinks,
                        contactVisibility,
                        updatedAt: profile?.updatedAt || Date.now(),
                    };
                } else {
                    profile = await upsertMemberProfile(
                        user.sub,
                        validation.data,
                    );
                    refreshDirectorySnapshotProfiles(user.sub);
                    formSuccess = "Profile updated successfully!";
                }
            }
        }
    } catch (err) {
        console.error("[Profile Form] Save failed:", err);
        formError = "An error occurred while saving your profile.";
    }
}

// Build list of existing social entries to render
const existingSocials: Array<{
    platform: string;
    label: string;
    placeholder: string;
    value: string;
    error?: string;
}> = [];

for (const p of SOCIAL_PLATFORMS) {
    const val = profile?.socials?.[p.id as keyof typeof profile.socials];
    const err = fieldErrors[`socials.${p.id}`];
    if ((typeof val === "string" && val.trim().length > 0) || err) {
        existingSocials.push({
            platform: p.id,
            label: p.label,
            placeholder: p.placeholder,
            value: typeof val === "string" ? val : "",
            error: err,
        });
    }
}
---

<Layout title="Edit Profile — Directory">
    <div class="max-w-2xl mx-auto py-6">
        <div class="mb-6">
            <BackLink href={`/u/${user.preferred_username}`}>
                Back to my profile
            </BackLink>
        </div>

        <div class="border border-foreground bg-card p-6 sm:p-8 mb-8">
            <div class="flex items-center gap-4 pb-6 border-b border-border">
                {safeUserAvatarUrl ? (
                    <img
                        src={safeUserAvatarUrl}
                        alt=""
                        width="64"
                        height="64"
                        referrerpolicy="no-referrer"
                        class="size-16 border border-foreground object-cover bg-muted shrink-0"
                    />
                ) : (
                    <div class="size-16 border border-foreground bg-ph-yellow text-ph-black flex items-center justify-center font-mono text-xl font-bold shrink-0">
                        {user.preferred_username.slice(0, 2).toUpperCase()}
                    </div>
                )}
                <div class="min-w-0 flex-1">
                    <h1 class="ph-headline text-2xl sm:text-3xl leading-tight">
                        EDIT DIRECTORY PROFILE
                    </h1>
                    <p class="font-mono text-sm text-foreground/80">
                        @{user.preferred_username}
                    </p>
                </div>
            </div>

            <!-- Notice about ID vs Directory -->
            <div class="mt-5 p-3.5 border border-foreground/30 bg-muted/50 text-xs font-sans text-foreground/85 flex items-start justify-between gap-3">
                <div>
                    <span class="font-bold">Managed on Purdue Hackers ID:</span>{" "}
                    Name, username, avatar, and contact information live on ID.
                </div>
                <a
                    href={config.idBase}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono font-bold uppercase underline shrink-0 hover:text-ph-orange"
                >
                    Edit on ID ↗
                </a>
            </div>

            <!-- Flash Alert Messages -->
            {formSuccess && (
                <div
                    id="status-banner"
                    class="mt-6 border border-foreground bg-ph-yellow/20 text-foreground p-4 font-mono text-sm flex items-center gap-2"
                >
                    <Icon
                        name="check"
                        class="size-4 text-foreground shrink-0"
                    />
                    <span>{formSuccess}</span>
                </div>
            )}
            {formError && (
                <div
                    id="status-banner"
                    class="mt-6 border border-ph-orange bg-ph-orange/15 text-foreground p-4 font-mono text-sm flex items-center gap-2"
                >
                    <Icon
                        name="exclamation-triangle"
                        class="size-4 text-ph-orange shrink-0"
                    />
                    <span>{formError}</span>
                </div>
            )}

            <!-- Form -->
            <form
                id="profile-form"
                data-username={user.preferred_username}
                method="POST"
                class="mt-6 flex flex-col gap-8"
            >
                <!-- Section 1: Headline & Spotlight -->
                <div class="flex flex-col gap-4">
                    <Separator label="Hacker Headline & Bio" />

                    <Field label="Headline" error={fieldErrors.headline}>
                        <Input
                            id="headline"
                            name="headline"
                            type="text"
                            maxlength="100"
                            placeholder="e.g. Systems hacker • Compilers & Keyboards"
                            value={profile?.headline || ""}
                        />
                        <div
                            class="text-right text-[11px] font-mono text-foreground/60"
                            id="headline-count"
                        >
                            {(profile?.headline || "").length} / 100
                        </div>
                    </Field>

                    <Field
                        label="Major"
                        hint="e.g. Computer Science, Electrical Engineering"
                        error={fieldErrors.major}
                    >
                        <Input
                            id="major"
                            name="major"
                            type="text"
                            maxlength="80"
                            placeholder="e.g. Computer Science"
                            value={profile?.major || ""}
                        />
                        <div
                            class="text-right text-[11px] font-mono text-foreground/60"
                            id="major-count"
                        >
                            {(profile?.major || "").length} / 80
                        </div>
                    </Field>

                    <Field label="About You / Bio" error={fieldErrors.bio}>
                        <Textarea
                            id="bio"
                            name="bio"
                            maxlength="600"
                            rows="4"
                            placeholder="Tell members about yourself..."
                        >
                            {profile?.bio || ""}
                        </Textarea>
                        <div
                            class="text-right text-[11px] font-mono text-foreground/60"
                            id="bio-count"
                        >
                            {(profile?.bio || "").length} / 600
                        </div>
                    </Field>
                </div>

                <!-- Section 2: Location & Timezone -->
                <div class="flex flex-col gap-4">
                    <Separator label="Location & Timezone" />

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <Field
                            label="Location / City"
                            hint="City & State/Country (e.g. West Lafayette, IN)"
                            error={fieldErrors.location}
                        >
                            <Input
                                id="location"
                                name="location"
                                type="text"
                                maxlength="80"
                                placeholder="West Lafayette, IN"
                                value={profile?.location || ""}
                            />
                        </Field>

                        <Field
                            label="Timezone (IANA)"
                            hint="Used to show your current local time on profile."
                            error={fieldErrors.timezone}
                        >
                            <div class="flex gap-2">
                                <Input
                                    id="timezone"
                                    name="timezone"
                                    type="text"
                                    placeholder="America/Indiana/Indianapolis"
                                    value={profile?.timezone || ""}
                                />
                                <button
                                    type="button"
                                    id="detect-tz-btn"
                                    class="border border-foreground bg-background hover:bg-muted px-2.5 font-mono text-xs font-semibold whitespace-nowrap cursor-pointer uppercase shrink-0"
                                    title="Detect my current timezone"
                                >
                                    Detect
                                </button>
                            </div>
                        </Field>
                    </div>
                </div>

                <!-- Section 3: Website & Socials -->
                <div class="flex flex-col gap-4">
                    <Separator label="Web & Social Accounts" />

                    <Field
                        label="Personal Website"
                        error={fieldErrors.websiteUrl}
                    >
                        <Input
                            id="websiteUrl"
                            name="websiteUrl"
                            type="url"
                            placeholder="https://yourdomain.com"
                            value={profile?.websiteUrl || ""}
                            autocorrect="off"
                            autocapitalize="off"
                            spellcheck="false"
                        />
                    </Field>

                    <div class="flex flex-col gap-3 pt-1">
                        <div class="flex flex-col gap-1">
                            <span class="font-mono text-xs font-semibold uppercase text-foreground">
                                Social Profiles
                            </span>
                            <p class="font-sans text-xs text-foreground/75">
                                Add links or handles to your GitHub, X,
                                LinkedIn, Bluesky, or other profiles.
                            </p>
                        </div>

                        <div id="socials-container" class="flex flex-col gap-3">
                            {existingSocials.map((item) => (
                                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 social-row">
                                    <Select
                                        name="social_platform"
                                        aria-label="Social platform"
                                        class="social-platform-select w-full sm:w-1/3 shrink-0"
                                    >
                                        {SOCIAL_PLATFORMS.map((p) => (
                                            <option
                                                value={p.id}
                                                selected={
                                                    p.id === item.platform
                                                }
                                            >
                                                {p.label}
                                            </option>
                                        ))}
                                    </Select>
                                    <div class="flex items-center gap-2 flex-1 min-w-0">
                                        <Input
                                            name="social_value"
                                            type="text"
                                            placeholder={item.placeholder}
                                            aria-label={`${item.label} handle or URL`}
                                            aria-invalid={
                                                item.error ? "true" : undefined
                                            }
                                            autocorrect="off"
                                            autocapitalize="off"
                                            spellcheck="false"
                                            class="flex-1 min-w-0"
                                            value={item.value}
                                        />
                                        <button
                                            type="button"
                                            class="remove-social-btn border border-foreground bg-background hover:bg-foreground hover:text-background size-10 flex items-center justify-center shrink-0 cursor-pointer"
                                            title="Remove social link"
                                            aria-label="Remove social link"
                                        >
                                            <Icon
                                                name="times"
                                                class="size-3.5"
                                            />
                                        </button>
                                    </div>
                                    {item.error && (
                                        <p class="text-xs font-mono text-ph-orange mt-0.5 sm:hidden">
                                            {item.error}
                                        </p>
                                    )}
                                </div>
                            ))}
                        </div>

                        <div class="mt-1">
                            <button
                                type="button"
                                id="add-social-btn"
                                class="border border-foreground bg-background hover:bg-foreground hover:text-background px-3 py-1.5 font-mono text-xs font-bold uppercase transition-colors inline-flex items-center gap-1.5 cursor-pointer"
                            >
                                <Icon name="plus" class="size-3" />
                                <span>Add Social</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Section 4: Custom Links -->
                <div class="flex flex-col gap-4">
                    <Separator label="Custom Links (Up to 5)" />
                    <p class="font-sans text-xs text-foreground/75 -mt-2">
                        Add links to your blog, Substack, itch.io, 3D models, or
                        anything else you build.
                    </p>

                    <div
                        id="custom-links-container"
                        class="flex flex-col gap-3"
                    >
                        {(profile?.customLinks && profile.customLinks.length > 0
                            ? profile.customLinks
                            : [{ label: "", url: "" }]
                        ).map((link, idx) => (
                            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 custom-link-row">
                                <Input
                                    name="custom_label"
                                    type="text"
                                    placeholder="Label (e.g. Resume, Blog)"
                                    aria-label="Link label"
                                    class="w-full sm:w-1/3 shrink-0"
                                    value={link.label}
                                    maxlength="40"
                                />
                                <div class="flex items-center gap-2 flex-1 min-w-0">
                                    <Input
                                        name="custom_url"
                                        type="url"
                                        placeholder="https://..."
                                        aria-label="Link URL"
                                        autocorrect="off"
                                        autocapitalize="off"
                                        spellcheck="false"
                                        class="flex-1 min-w-0"
                                        value={link.url}
                                    />
                                    <button
                                        type="button"
                                        class="remove-link-btn border border-foreground bg-background hover:bg-foreground hover:text-background size-10 flex items-center justify-center shrink-0 cursor-pointer"
                                        title="Remove link"
                                        aria-label="Remove link"
                                    >
                                        <Icon name="times" class="size-3.5" />
                                    </button>
                                </div>
                            </div>
                        ))}
                    </div>

                    <div class="mt-1">
                        <button
                            type="button"
                            id="add-link-btn"
                            class="border border-foreground bg-background hover:bg-foreground hover:text-background px-3 py-1.5 font-mono text-xs font-bold uppercase transition-colors inline-flex items-center gap-1.5 cursor-pointer"
                        >
                            <Icon name="plus" class="size-3" />
                            <span>Add Link</span>
                        </button>
                    </div>
                </div>

                <!-- Section 5: Contact Privacy & Visibility -->
                <div class="flex flex-col gap-4">
                    <Separator label="Contact Privacy & Visibility" />
                    <p class="font-sans text-xs text-foreground/75 -mt-2">
                        Control which contact details from your Purdue Hackers
                        ID account are visible to logged-in members on your
                        public profile and directory cards.
                    </p>

                    {memberEmails.length > 0 || memberPhone ? (
                        <fieldset class="flex flex-col gap-4 border border-foreground bg-muted/20 p-4 sm:p-5 m-0">
                            <legend class="sr-only">
                                Contact Privacy and Visibility Settings
                            </legend>

                            <!-- Email Addresses -->
                            {memberEmails.length > 0 && (
                                <div class="flex flex-col gap-2.5">
                                    <span class="flex items-center gap-1.5 font-mono text-xs font-semibold uppercase text-foreground">
                                        <Icon
                                            name="envelope"
                                            class="size-3.5"
                                        />
                                        <span>Email Visibility</span>
                                    </span>
                                    <div class="flex flex-col gap-2 pl-1">
                                        {memberEmails.map((em) => {
                                            const isChecked = isEmailVisible(
                                                em.email,
                                                profile,
                                                Boolean(em.primary),
                                            );
                                            return (
                                                <div class="contact-vis-row flex items-center justify-between gap-3 py-1.5 border-b border-border/50 last:border-0">
                                                    <div class="flex items-center gap-2 min-w-0">
                                                        <Checkbox
                                                            name="visible_email"
                                                            value={em.email}
                                                            checked={isChecked}
                                                            id={`email-vis-${em.email}`}
                                                        >
                                                            <span class="font-mono text-xs sm:text-sm font-medium break-all select-none">
                                                                {em.email}
                                                            </span>
                                                        </Checkbox>
                                                        {em.primary && (
                                                            <span class="border border-foreground bg-foreground text-background text-[10px] font-mono uppercase px-1 py-0.2 shrink-0">
                                                                Primary
                                                            </span>
                                                        )}
                                                        {em.verified ===
                                                            false && (
                                                            <span class="border border-ph-orange text-ph-orange text-[10px] font-mono uppercase px-1 py-0.2 shrink-0">
                                                                Unverified
                                                            </span>
                                                        )}
                                                    </div>
                                                    <span class="vis-status-text font-mono text-[11px] text-foreground/60 shrink-0 hidden sm:inline">
                                                        {isChecked
                                                            ? "Visible to members"
                                                            : "Hidden"}
                                                    </span>
                                                </div>
                                            );
                                        })}
                                    </div>
                                </div>
                            )}

                            <!-- Phone Number -->
                            {memberPhone && (
                                <div
                                    class:list={[
                                        "flex flex-col gap-2.5",
                                        memberEmails.length > 0 &&
                                            "pt-3 border-t border-border",
                                    ]}
                                >
                                    <span class="flex items-center gap-1.5 font-mono text-xs font-semibold uppercase text-foreground">
                                        <Icon name="phone" class="size-3.5" />
                                        <span>Phone Number Visibility</span>
                                    </span>
                                    <div class="contact-vis-row flex items-center justify-between gap-3 py-1.5 pl-1">
                                        <Checkbox
                                            name="visible_phone"
                                            value="1"
                                            checked={isPhoneVisible(profile)}
                                            id="phone-vis-checkbox"
                                        >
                                            <span class="font-mono text-xs sm:text-sm font-medium select-none">
                                                {formatPhone(memberPhone)}
                                            </span>
                                        </Checkbox>
                                        <span class="vis-status-text font-mono text-[11px] text-foreground/60 shrink-0 hidden sm:inline">
                                            {isPhoneVisible(profile)
                                                ? "Visible to members"
                                                : "Hidden"}
                                        </span>
                                    </div>
                                </div>
                            )}
                        </fieldset>
                    ) : (
                        <div class="border border-dashed border-foreground/50 p-4 font-mono text-xs text-foreground/70 flex items-center justify-between gap-3">
                            <span>
                                No email or phone on file with Purdue Hackers
                                ID.
                            </span>
                            <a
                                href={config.idBase}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-bold underline uppercase shrink-0 hover:text-ph-orange"
                            >
                                Add on ID ↗
                            </a>
                        </div>
                    )}
                </div>

                <!-- Actions -->
                <div class="pt-6 border-t border-border flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <Button
                            type="submit"
                            id="submit-btn"
                            variant="solid"
                            class="bg-ph-yellow text-ph-black hover:bg-foreground hover:text-background font-mono font-bold"
                        >
                            Save Profile
                        </Button>
                        <Button
                            type="button"
                            id="open-preview-btn"
                            variant="outline"
                            class="font-mono font-bold inline-flex items-center gap-1.5"
                        >
                            <Icon name="user" class="size-3.5" />
                            <span>Preview</span>
                        </Button>
                    </div>
                    <a
                        href={`/u/${user.preferred_username}`}
                        class="border border-foreground bg-card hover:bg-muted px-4 py-2 font-mono text-sm font-semibold uppercase text-center no-underline text-foreground"
                    >
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Preview Modal Dialog -->
    <dialog
        id="preview-dialog"
        closedby="any"
        aria-labelledby="preview-title"
        class="border-2 border-foreground bg-card text-foreground p-0 max-w-2xl w-[calc(100vw-2rem)] max-h-[85vh] shadow-[6px_6px_0_0_currentColor] m-auto"
    >
        <!-- Header -->
        <div class="p-4 sm:p-5 border-b border-foreground flex items-center justify-between gap-3 bg-muted/30">
            <div>
                <h2
                    id="preview-title"
                    class="ph-headline text-lg sm:text-xl leading-tight"
                >
                    PREVIEW PROFILE CHANGES
                </h2>
                <p class="font-mono text-xs text-foreground/75 mt-0.5">
                    Live preview of how your profile looks to other hackers.
                </p>
            </div>
            <form method="dialog">
                <button
                    type="submit"
                    class="border border-foreground bg-background hover:bg-foreground hover:text-background size-8 flex items-center justify-center shrink-0 cursor-pointer"
                    title="Close preview (Esc)"
                    aria-label="Close preview"
                >
                    <Icon name="times" class="size-3.5" />
                </button>
            </form>
        </div>

        <!-- View Switcher Tabs -->
        <div class="border-b border-foreground flex items-center bg-card px-4 pt-2 gap-2">
            <button
                type="button"
                id="tab-btn-profile"
                class="preview-tab-btn border-t border-x border-foreground bg-ph-yellow text-ph-black px-3.5 py-1.5 font-mono text-xs font-bold uppercase cursor-pointer"
                data-target="preview-profile-view"
            >
                Public Profile
            </button>
            <button
                type="button"
                id="tab-btn-card"
                class="preview-tab-btn border-t border-x border-foreground/40 bg-muted/40 text-foreground/70 hover:text-foreground px-3.5 py-1.5 font-mono text-xs font-bold uppercase cursor-pointer"
                data-target="preview-card-view"
            >
                Directory Card
            </button>
        </div>

        <!-- Scrollable Content -->
        <div class="overflow-y-auto p-5 sm:p-6 flex-1 flex flex-col gap-6 max-h-[calc(85vh-165px)]">
            <!-- 1. Public Profile View -->
            <div
                id="preview-profile-view"
                class="preview-panel flex flex-col gap-5"
            >
                <!-- Profile Header Card -->
                <div class="border border-foreground bg-card p-5 sm:p-6">
                    <div class="flex flex-col sm:flex-row items-start gap-4">
                        {safeUserAvatarUrl ? (
                            <img
                                src={safeUserAvatarUrl}
                                alt=""
                                width="80"
                                height="80"
                                referrerpolicy="no-referrer"
                                class="size-20 shrink-0 border border-foreground object-cover bg-muted"
                            />
                        ) : (
                            <div class="size-20 shrink-0 border border-foreground bg-ph-yellow text-ph-black flex items-center justify-center font-mono text-2xl font-bold">
                                {user.preferred_username
                                    .slice(0, 2)
                                    .toUpperCase()}
                            </div>
                        )}
                        <div class="flex-1 min-w-0">
                            <div class="flex flex-wrap items-center gap-2 mb-1">
                                <span class="ph-headline text-2xl sm:text-3xl leading-tight">
                                    {user.name || user.preferred_username}
                                </span>
                            </div>
                            <p class="font-mono text-sm font-semibold text-foreground/85 mb-2">
                                @{user.preferred_username}
                            </p>

                            <!-- Dynamic Headline -->
                            <p
                                id="pv-headline"
                                class="font-sans text-sm sm:text-base text-foreground mb-2.5 font-medium leading-snug hidden"
                            ></p>

                            <!-- Dynamic Location & Timezone -->
                            <div
                                id="pv-location-row"
                                class="flex flex-wrap items-center gap-3 text-xs font-mono text-foreground/80 mb-3 hidden"
                            >
                                <span
                                    id="pv-location-item"
                                    class="inline-flex items-center gap-1 hidden"
                                >
                                    <Icon
                                        name="location-pin"
                                        class="size-3.5 text-foreground/70"
                                    />
                                    <span id="pv-location-text"></span>
                                </span>
                                <span
                                    id="pv-timezone-item"
                                    class="inline-flex items-center gap-1 border-l border-border pl-3 hidden"
                                >
                                    <Icon
                                        name="clock"
                                        class="size-3.5 text-foreground/70"
                                    />
                                    <span id="pv-timezone-text"></span>
                                </span>
                            </div>

                            <!-- Badges -->
                            <div class="flex flex-wrap items-center gap-2">
                                <Badge
                                    color="outline"
                                    id="pv-major-badge"
                                    class="hidden"
                                ></Badge>
                                {user.graduation_year && (
                                    <Badge color="default">
                                        Class of {user.graduation_year}
                                    </Badge>
                                )}
                                {(user.roles || [])
                                    .filter(
                                        (r: string) =>
                                            r.toLowerCase() !== "admin",
                                    )
                                    .map((r: string) => (
                                        <Badge
                                            color={
                                                r.toLowerCase() === "organizer"
                                                    ? "yellow"
                                                    : r.toLowerCase() ===
                                                        "alumni"
                                                      ? "purple"
                                                      : "default"
                                            }
                                        >
                                            {r}
                                        </Badge>
                                    ))}
                            </div>

                            <!-- Dynamic Social Pills -->
                            <div
                                id="pv-socials-row"
                                class="flex flex-wrap items-center gap-2 mt-4 pt-3 border-t border-border hidden"
                            ></div>
                        </div>
                    </div>
                </div>

                <!-- Dynamic About & Hacking -->
                <div id="pv-about-section" class="flex flex-col gap-3 hidden">
                    <Separator label="About & Hacking" />

                    <!-- Bio Card -->
                    <div
                        id="pv-bio-card"
                        class="border border-foreground bg-card p-4 hidden"
                    >
                        <span class="ph-subheadline text-xs block mb-2 text-foreground/80">
                            About Me
                        </span>
                        <div
                            id="pv-bio-text"
                            class="font-sans text-sm text-foreground leading-relaxed whitespace-pre-line"
                        ></div>
                    </div>

                    <!-- Custom Links Card -->
                    <div
                        id="pv-links-card"
                        class="border border-foreground bg-card p-4 hidden"
                    >
                        <span class="ph-subheadline text-xs block mb-2 text-foreground/80">
                            External Links
                        </span>
                        <div
                            id="pv-links-list"
                            class="flex flex-wrap gap-2"
                        ></div>
                    </div>
                </div>

                <!-- Dynamic Contact & Accounts -->
                <div id="pv-contact-section" class="flex flex-col gap-3 hidden">
                    <Separator label="Contact & Accounts" />

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <!-- Email Card -->
                        <div
                            id="pv-email-card"
                            class="border border-foreground p-4 bg-card flex flex-col justify-between hidden"
                        >
                            <div>
                                <span class="ph-subheadline text-xs flex items-center gap-1.5 mb-2 text-foreground/85">
                                    <Icon name="envelope" class="size-3.5" />
                                    <span>Email Address</span>
                                </span>
                                <div
                                    id="pv-emails-list"
                                    class="flex flex-col gap-2"
                                ></div>
                            </div>
                        </div>

                        <!-- Phone Card -->
                        <div
                            id="pv-phone-card"
                            class="border border-foreground p-4 bg-card flex flex-col justify-between hidden"
                        >
                            <div>
                                <span class="ph-subheadline text-xs flex items-center gap-1.5 mb-2 text-foreground/85">
                                    <Icon name="phone" class="size-3.5" />
                                    <span>Phone Number</span>
                                </span>
                                <p
                                    id="pv-phone-text"
                                    class="font-mono text-sm font-semibold"
                                ></p>
                            </div>
                        </div>

                        <!-- Discord Card -->
                        {member?.discord_id && (
                            <div class="border border-foreground p-4 bg-card flex flex-col justify-between">
                                <div>
                                    <span class="ph-subheadline text-xs flex items-center gap-1.5 mb-2 text-foreground/85">
                                        <Icon
                                            name="discord"
                                            class="size-3.5 text-ph-purple dark:text-ph-periwinkle"
                                        />
                                        <span>Discord</span>
                                    </span>
                                    {member.discord?.guildNickname ? (
                                        <div>
                                            <p class="font-sans text-sm font-bold text-foreground leading-snug">
                                                {member.discord.guildNickname}
                                            </p>
                                            <p class="font-mono text-xs text-foreground/75 mt-0.5">
                                                @{member.discord.username}
                                            </p>
                                        </div>
                                    ) : member.discord?.username ? (
                                        <div>
                                            <p class="font-mono text-sm font-semibold text-foreground">
                                                @{member.discord.username}
                                            </p>
                                            {member.discord.globalName && member.discord.globalName.toLowerCase() !== member.discord.username.toLowerCase() && (
                                                <p class="font-sans text-xs text-foreground/75 mt-0.5">
                                                    {member.discord.globalName}
                                                </p>
                                            )}
                                        </div>
                                    ) : (
                                        <p class="font-mono text-sm font-semibold text-foreground">
                                            Connected
                                        </p>
                                    )}
                                </div>
                            </div>
                        )}
                    </div>
                </div>
            </div>

            <!-- 2. Directory Member Card View -->
            <div
                id="preview-card-view"
                class="preview-panel hidden flex flex-col items-center justify-center py-4"
            >
                <div class="w-full max-w-sm border border-foreground bg-card p-5 shadow-[4px_4px_0_0_currentColor] flex flex-col justify-between">
                    <div>
                        <!-- Header -->
                        <div class="flex items-start gap-3.5">
                            {safeUserAvatarUrl ? (
                                <img
                                    src={safeUserAvatarUrl}
                                    alt=""
                                    width="48"
                                    height="48"
                                    referrerpolicy="no-referrer"
                                    class="size-12 shrink-0 border border-foreground object-cover bg-muted"
                                />
                            ) : (
                                <div class="size-12 shrink-0 border border-foreground bg-ph-yellow text-ph-black flex items-center justify-center font-mono text-sm font-bold">
                                    {user.preferred_username
                                        .slice(0, 2)
                                        .toUpperCase()}
                                </div>
                            )}
                            <div class="min-w-0 flex-1">
                                <h3 class="ph-headline text-lg leading-tight truncate">
                                    {user.name || user.preferred_username}
                                </h3>
                                <div class="flex items-center gap-2 mt-0.5">
                                    <span class="font-mono text-xs font-semibold text-foreground/85 truncate">
                                        @{user.preferred_username}
                                    </span>
                                    {user.graduation_year && (
                                        <span class="font-mono text-xs font-bold px-1 border border-foreground bg-card shrink-0">
                                            '
                                            {String(user.graduation_year).slice(
                                                -2,
                                            )}
                                        </span>
                                    )}
                                </div>
                                <p
                                    id="pvc-headline"
                                    class="font-sans text-xs text-foreground/80 mt-1.5 line-clamp-1 font-medium hidden"
                                ></p>
                                <div
                                    id="pvc-location"
                                    class="inline-flex items-center gap-1 text-[11px] font-mono text-foreground/70 mt-1 hidden"
                                >
                                    <Icon name="location-pin" class="size-3" />
                                    <span id="pvc-location-text"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Bio Snippet -->
                        <p
                            id="pvc-bio"
                            class="font-sans text-xs text-foreground/75 mt-3 line-clamp-2 leading-relaxed hidden"
                        ></p>

                        <!-- Roles -->
                        <div class="flex flex-wrap items-center gap-1.5 mt-3 pt-3 border-t border-border">
                            <Badge
                                color="outline"
                                id="pvc-major-badge"
                                class="text-[10px] hidden"
                            ></Badge>
                            {(user.roles || [])
                                .filter(
                                    (r: string) => r.toLowerCase() !== "admin",
                                )
                                .map((r: string) => (
                                    <Badge
                                        color={
                                            r.toLowerCase() === "organizer"
                                                ? "yellow"
                                                : r.toLowerCase() === "alumni"
                                                  ? "purple"
                                                  : "default"
                                        }
                                        class="text-[10px]"
                                    >
                                        {r}
                                    </Badge>
                                ))}
                        </div>
                    </div>

                    <!-- Card Footer Contact Info -->
                    <footer
                        id="pvc-footer"
                        class="mt-4 pt-3 border-t border-border flex flex-wrap items-center gap-3 text-xs font-mono text-foreground/85 hidden"
                    >
                        <span
                            id="pvc-footer-email"
                            class="inline-flex items-center gap-1.5 truncate max-w-[170px] hidden"
                        >
                            <Icon name="envelope" class="size-3.5" />
                            <span
                                id="pvc-footer-email-text"
                                class="truncate"
                            ></span>
                        </span>
                        <span
                            id="pvc-footer-phone"
                            class="inline-flex items-center gap-1.5 truncate hidden"
                        >
                            <Icon name="phone" class="size-3.5 shrink-0" />
                            <span
                                id="pvc-footer-phone-text"
                                class="truncate"
                            ></span>
                        </span>
                        {member?.discord_id && (
                            <span class="inline-flex items-center gap-1.5 text-foreground truncate max-w-[140px]">
                                <Icon
                                    name="discord"
                                    class="size-3.5 text-ph-purple dark:text-ph-periwinkle"
                                />
                                <span class="font-mono truncate">
                                    {member.discord?.username ? `@${member.discord.username}` : "Discord"}
                                </span>
                            </span>
                        )}
                    </footer>
                </div>
            </div>
        </div>

        <!-- Footer Actions -->
        <div class="p-3.5 sm:p-4 border-t border-foreground flex items-center justify-between gap-3 bg-muted/20">
            <span class="font-mono text-[11px] text-foreground/60 hidden sm:inline">
                Unsaved changes are shown here in real time.
            </span>
            <div class="flex items-center gap-2.5 ml-auto">
                <form method="dialog">
                    <button
                        type="submit"
                        class="border border-foreground bg-background hover:bg-muted px-3.5 py-1.5 font-mono text-xs font-semibold uppercase cursor-pointer"
                    >
                        Back to Edit
                    </button>
                </form>
                <button
                    type="button"
                    id="preview-save-btn"
                    class="border border-foreground bg-ph-yellow text-ph-black hover:bg-foreground hover:text-background px-4 py-1.5 font-mono text-xs font-bold uppercase cursor-pointer"
                >
                    Save Profile
                </button>
            </div>
        </div>
    </dialog>
</Layout>

<style>
    /* Preview Dialog Containment & Backdrop */
    dialog#preview-dialog:modal {
        overscroll-behavior: contain;
    }
    dialog#preview-dialog::backdrop {
        background: rgba(0, 0, 0, 0.65);
        backdrop-filter: blur(2px);
        overflow: hidden;
        overscroll-behavior: contain;
    }
</style>

<script>
    // Live Character Counters
    function setupCharCounter(inputId: string, counterId: string, max: number) {
        const input = document.getElementById(inputId) as
            HTMLInputElement | HTMLTextAreaElement | null;
        const counter = document.getElementById(counterId);
        if (!input || !counter) return;

        const update = () => {
            counter.textContent = `${input.value.length} / ${max}`;
        };
        input.addEventListener("input", update);
    }

    setupCharCounter("headline", "headline-count", 100);
    setupCharCounter("major", "major-count", 80);
    setupCharCounter("bio", "bio-count", 600);

    // Detect Timezone
    const detectBtn = document.getElementById("detect-tz-btn");
    const tzInput = document.getElementById(
        "timezone",
    ) as HTMLInputElement | null;
    if (detectBtn && tzInput) {
        detectBtn.addEventListener("click", () => {
            try {
                const detected =
                    Intl.DateTimeFormat().resolvedOptions().timeZone;
                if (detected) {
                    tzInput.value = detected;
                }
            } catch (err) {
                console.error("Failed to detect timezone:", err);
            }
        });
    }

    // Dynamic Social Links Repeater
    const socialsContainer = document.getElementById("socials-container");
    const addSocialBtn = document.getElementById("add-social-btn");

    const SOCIAL_METAS = [
        { id: "github", label: "GitHub", placeholder: "@username or full URL" },
        { id: "x", label: "X (Twitter)", placeholder: "@handle or full URL" },
        {
            id: "bluesky",
            label: "Bluesky",
            placeholder: "user.bsky.social or full URL",
        },
        {
            id: "youtube",
            label: "YouTube",
            placeholder: "@channel or full URL",
        },
        {
            id: "instagram",
            label: "Instagram",
            placeholder: "@handle or full URL",
        },
        {
            id: "linkedin",
            label: "LinkedIn",
            placeholder: "in/username or full URL",
        },
        {
            id: "mastodon",
            label: "Mastodon",
            placeholder: "https://instance/@user or @user@instance",
        },
    ];

    function attachSocialRowEvents(row: HTMLElement) {
        const removeBtn = row.querySelector(".remove-social-btn");
        const select = row.querySelector<HTMLSelectElement>(
            ".social-platform-select",
        );
        const input = row.querySelector<HTMLInputElement>(
            "input[name='social_value']",
        );

        if (select && input) {
            select.addEventListener("change", () => {
                input.removeAttribute("aria-invalid");
                const meta = SOCIAL_METAS.find((p) => p.id === select.value);
                if (meta) {
                    input.placeholder = meta.placeholder;
                    input.setAttribute(
                        "aria-label",
                        `${meta.label} handle or URL`,
                    );
                }
            });
        }

        if (input) {
            input.addEventListener("input", () => {
                input.removeAttribute("aria-invalid");
            });
        }

        if (removeBtn) {
            removeBtn.addEventListener("click", () => {
                row.remove();
            });
        }
    }

    if (socialsContainer) {
        socialsContainer
            .querySelectorAll<HTMLElement>(".social-row")
            .forEach(attachSocialRowEvents);
    }

    if (addSocialBtn && socialsContainer) {
        addSocialBtn.addEventListener("click", () => {
            const currentRows =
                socialsContainer.querySelectorAll(".social-row");
            if (currentRows.length >= SOCIAL_METAS.length) {
                alert("You have added all available social platforms.");
                return;
            }

            const used = new Set(
                Array.from(
                    socialsContainer.querySelectorAll<HTMLSelectElement>(
                        ".social-platform-select",
                    ),
                ).map((s) => s.value),
            );
            const nextMeta =
                SOCIAL_METAS.find((p) => !used.has(p.id)) || SOCIAL_METAS[0];

            const newRow = document.createElement("div");
            newRow.className =
                "flex flex-col sm:flex-row items-stretch sm:items-center gap-2 social-row";

            const optionsHtml = SOCIAL_METAS.map(
                (p) =>
                    `<option value="${p.id}" ${p.id === nextMeta.id ? "selected" : ""}>${p.label}</option>`,
            ).join("");

            newRow.innerHTML = `
                <select
                    name="social_platform"
                    aria-label="Social platform"
                    class="social-platform-select h-10 min-w-0 w-full sm:w-1/3 shrink-0 border border-input bg-card px-3 font-sans text-[15px] text-card-foreground outline-none transition-colors duration-150 ease-quint focus-visible:border-foreground cursor-pointer"
                >
                    ${optionsHtml}
                </select>
                <div class="flex items-center gap-2 flex-1 min-w-0">
                    <input
                        name="social_value"
                        type="text"
                        placeholder="${nextMeta.placeholder}"
                        aria-label="${nextMeta.label} handle or URL"
                        autocorrect="off"
                        autocapitalize="off"
                        spellcheck="false"
                        class="h-10 min-w-0 flex-1 border border-input bg-card px-3 font-sans text-[15px] text-card-foreground outline-none transition-colors duration-150 ease-quint placeholder:text-card-foreground/55 focus-visible:border-foreground"
                    />
                    <button
                        type="button"
                        class="remove-social-btn border border-foreground bg-background hover:bg-foreground hover:text-background size-10 flex items-center justify-center shrink-0 cursor-pointer"
                        title="Remove social link"
                        aria-label="Remove social link"
                    >
                        <svg viewBox="0 0 24 24" fill="currentColor" class="size-3.5"><polygon points="14 13 15 13 15 14 16 14 16 15 17 15 17 16 18 16 18 17 19 17 19 18 20 18 20 19 21 19 21 20 22 20 22 21 21 21 21 22 20 22 20 21 19 21 19 20 18 20 18 19 17 19 17 18 16 18 16 17 15 17 15 16 14 16 14 15 13 15 13 14 11 14 11 15 10 15 10 16 9 16 9 17 8 17 8 18 7 18 7 19 6 19 6 20 5 20 5 21 4 21 4 22 3 22 3 21 2 21 2 20 3 20 3 19 4 19 4 18 5 18 5 17 6 17 6 16 7 16 7 15 8 15 8 14 9 14 9 13 10 13 10 11 9 11 9 10 8 10 8 9 7 9 7 8 6 8 6 7 5 7 5 6 4 6 4 5 3 5 3 4 2 4 2 3 3 3 3 2 4 2 4 3 5 3 5 4 6 4 6 5 7 5 7 6 8 6 8 7 9 7 9 8 10 8 10 9 11 9 11 10 13 10 13 9 14 9 14 8 15 8 15 7 16 7 16 6 17 6 17 5 18 5 18 4 19 4 19 3 20 3 20 2 21 2 21 3 22 3 22 4 21 4 21 5 20 5 20 6 19 6 19 7 18 7 18 8 17 8 17 9 16 9 16 10 15 10 15 11 14 11 14 13"/></svg>
                    </button>
                </div>
            `;
            socialsContainer.appendChild(newRow);
            attachSocialRowEvents(newRow);
            newRow
                .querySelector<HTMLInputElement>("input[name='social_value']")
                ?.focus();
        });
    }

    // Dynamic Custom Links Repeater
    const linksContainer = document.getElementById("custom-links-container");
    const addLinkBtn = document.getElementById("add-link-btn");

    function attachRowEvents(row: HTMLElement) {
        const removeBtn = row.querySelector(".remove-link-btn");
        if (removeBtn) {
            removeBtn.addEventListener("click", () => {
                const rows =
                    linksContainer?.querySelectorAll(".custom-link-row");
                if (rows && rows.length > 1) {
                    row.remove();
                } else {
                    // Just clear inputs if it's the last row
                    const inputs = row.querySelectorAll("input");
                    inputs.forEach((i) => (i.value = ""));
                }
            });
        }
    }

    if (linksContainer) {
        linksContainer
            .querySelectorAll<HTMLElement>(".custom-link-row")
            .forEach(attachRowEvents);
    }

    if (addLinkBtn && linksContainer) {
        addLinkBtn.addEventListener("click", () => {
            const currentRows =
                linksContainer.querySelectorAll(".custom-link-row");
            if (currentRows.length >= 5) {
                alert("You can add up to 5 custom links.");
                return;
            }

            const newRow = document.createElement("div");
            newRow.className =
                "flex flex-col sm:flex-row items-stretch sm:items-center gap-2 custom-link-row";
            newRow.innerHTML = `
                <input
                    name="custom_label"
                    type="text"
                    placeholder="Label (e.g. Resume, Blog)"
                    aria-label="Link label"
                    class="h-10 min-w-0 w-full sm:w-1/3 shrink-0 border border-input bg-card px-3 font-sans text-[15px] text-card-foreground outline-none transition-colors duration-150 ease-quint placeholder:text-card-foreground/55 focus-visible:border-foreground"
                    maxlength="40"
                />
                <div class="flex items-center gap-2 flex-1 min-w-0">
                    <input
                        name="custom_url"
                        type="url"
                        placeholder="https://..."
                        aria-label="Link URL"
                        autocorrect="off"
                        autocapitalize="off"
                        spellcheck="false"
                        class="h-10 min-w-0 flex-1 border border-input bg-card px-3 font-sans text-[15px] text-card-foreground outline-none transition-colors duration-150 ease-quint placeholder:text-card-foreground/55 focus-visible:border-foreground"
                    />
                    <button
                        type="button"
                        class="remove-link-btn border border-foreground bg-background hover:bg-foreground hover:text-background size-10 flex items-center justify-center shrink-0 cursor-pointer"
                        title="Remove link"
                        aria-label="Remove link"
                    >
                        <svg viewBox="0 0 24 24" fill="currentColor" class="size-3.5"><polygon points="14 13 15 13 15 14 16 14 16 15 17 15 17 16 18 16 18 17 19 17 19 18 20 18 20 19 21 19 21 20 22 20 22 21 21 21 21 22 20 22 20 21 19 21 19 20 18 20 18 19 17 19 17 18 16 18 16 17 15 17 15 16 14 16 14 15 13 15 13 14 11 14 11 15 10 15 10 16 9 16 9 17 8 17 8 18 7 18 7 19 6 19 6 20 5 20 5 21 4 21 4 22 3 22 3 21 2 21 2 20 3 20 3 19 4 19 4 18 5 18 5 17 6 17 6 16 7 16 7 15 8 15 8 14 9 14 9 13 10 13 10 11 9 11 9 10 8 10 8 9 7 9 7 8 6 8 6 7 5 7 5 6 4 6 4 5 3 5 3 4 2 4 2 3 3 3 3 2 4 2 4 3 5 3 5 4 6 4 6 5 7 5 7 6 8 6 8 7 9 7 9 8 10 8 10 9 11 9 11 10 13 10 13 9 14 9 14 8 15 8 15 7 16 7 16 6 17 6 17 5 18 5 18 4 19 4 19 3 20 3 20 2 21 2 21 3 22 3 22 4 21 4 21 5 20 5 20 6 19 6 19 7 18 7 18 8 17 8 17 9 16 9 16 10 15 10 15 11 14 11 14 13"/></svg>
                    </button>
                </div>
            `;
            linksContainer.appendChild(newRow);
            attachRowEvents(newRow);
        });
    }

    // Live feedback for visibility toggles
    document
        .querySelectorAll<HTMLInputElement>(
            'input[name="visible_email"], input[name="visible_phone"]',
        )
        .forEach((cb) => {
            cb.addEventListener("change", () => {
                const statusEl = cb
                    .closest(".contact-vis-row")
                    ?.querySelector(".vis-status-text");
                if (statusEl) {
                    statusEl.textContent = cb.checked
                        ? "Visible to members"
                        : "Hidden";
                }
            });
        });

    // Client-side enhanced submit with JSON API
    const form = document.getElementById(
        "profile-form",
    ) as HTMLFormElement | null;
    const submitBtn = document.getElementById(
        "submit-btn",
    ) as HTMLButtonElement | null;

    if (form && submitBtn) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const originalText = submitBtn.textContent;
            submitBtn.textContent = "Saving...";
            submitBtn.disabled = true;

            const existingBanner = document.getElementById("status-banner");
            if (existingBanner) existingBanner.remove();

            const formData = new FormData(form);
            const customLabelValues = formData.getAll("custom_label");
            const customUrlValues = formData.getAll("custom_url");
            const customLinks = customLabelValues
                .map((lbl, idx) => ({
                    label: lbl.toString(),
                    url: (customUrlValues[idx] || "").toString(),
                }))
                .filter((l) => l.label.trim() || l.url.trim());

            const socialPlatforms = formData.getAll("social_platform");
            const socialValues = formData.getAll("social_value");
            const socials: Record<string, string> = {
                github: "",
                x: "",
                linkedin: "",
                instagram: "",
                youtube: "",
                bluesky: "",
                mastodon: "",
            };
            socialPlatforms.forEach((p, idx) => {
                const plat = p.toString().trim();
                const val = (socialValues[idx] || "").toString().trim();
                if (plat in socials) {
                    socials[plat] = val;
                }
            });

            const emailCheckboxes = form.querySelectorAll<HTMLInputElement>(
                'input[name="visible_email"]',
            );
            const emailsMap: Record<string, boolean> = {};
            emailCheckboxes.forEach((cb) => {
                const em = cb.value.trim().toLowerCase();
                if (em) {
                    emailsMap[em] = cb.checked;
                }
            });

            const phoneCheckbox = form.querySelector<HTMLInputElement>(
                'input[name="visible_phone"]',
            );
            const phoneVisible = phoneCheckbox ? phoneCheckbox.checked : false;

            const payload = {
                headline: formData.get("headline")?.toString() || "",
                major: formData.get("major")?.toString() || "",
                bio: formData.get("bio")?.toString() || "",
                location: formData.get("location")?.toString() || "",
                timezone: formData.get("timezone")?.toString() || "",
                websiteUrl: formData.get("websiteUrl")?.toString() || "",
                socials,
                customLinks,
                contactVisibility: {
                    emails: emailsMap,
                    phone: phoneVisible,
                },
            };

            try {
                const res = await fetch("/api/profile", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify(payload),
                });

                const data = await res.json();
                if (!res.ok) {
                    const errBanner = document.createElement("div");
                    errBanner.id = "status-banner";
                    errBanner.className =
                        "mt-6 border border-ph-orange bg-ph-orange/15 text-foreground p-4 font-mono text-sm";
                    errBanner.textContent =
                        data.error || "Failed to save profile.";
                    if (data.fieldErrors) {
                        const errList = Object.entries(data.fieldErrors)
                            .map(([k, v]) => `${k}: ${v}`)
                            .join(", ");
                        errBanner.textContent += ` (${errList})`;

                        // Mark invalid inputs on active social rows
                        document
                            .querySelectorAll<HTMLElement>(".social-row")
                            .forEach((row) => {
                                const select =
                                    row.querySelector<HTMLSelectElement>(
                                        ".social-platform-select",
                                    );
                                const input =
                                    row.querySelector<HTMLInputElement>(
                                        "input[name='social_value']",
                                    );
                                if (
                                    select &&
                                    input &&
                                    data.fieldErrors[`socials.${select.value}`]
                                ) {
                                    input.setAttribute("aria-invalid", "true");
                                }
                            });
                    }
                    form.before(errBanner);
                    window.scrollTo({ top: 0, behavior: "smooth" });
                } else {
                    const okBanner = document.createElement("div");
                    okBanner.id = "status-banner";
                    okBanner.className =
                        "mt-6 border border-foreground bg-ph-yellow text-ph-black p-4 font-mono text-sm font-bold flex items-center justify-between";

                    const msgSpan = document.createElement("span");
                    msgSpan.textContent = "Profile updated successfully!";

                    const viewLink = document.createElement("a");
                    const username = form.dataset.username || "";
                    viewLink.href = `/u/${encodeURIComponent(username)}`;
                    viewLink.className = "underline ml-4 text-xs font-bold";
                    viewLink.textContent = "View Profile →";

                    okBanner.append(msgSpan, viewLink);
                    form.before(okBanner);
                    window.scrollTo({ top: 0, behavior: "smooth" });
                }
            } catch (err) {
                console.error("Profile save error:", err);
                const errBanner = document.createElement("div");
                errBanner.id = "status-banner";
                errBanner.className =
                    "mt-6 border border-ph-orange bg-ph-orange/15 text-foreground p-4 font-mono text-sm";
                errBanner.textContent = "Network error while saving profile.";
                form.before(errBanner);
            } finally {
                submitBtn.textContent = originalText;
                submitBtn.disabled = false;
            }
        });
    }

    // Live Profile Preview Modal Logic
    const openPreviewBtn = document.getElementById("open-preview-btn");
    const previewDialog = document.getElementById(
        "preview-dialog",
    ) as HTMLDialogElement | null;
    const previewSaveBtn = document.getElementById("preview-save-btn");
    const tabBtnProfile = document.getElementById("tab-btn-profile");
    const tabBtnCard = document.getElementById("tab-btn-card");
    const viewProfile = document.getElementById("preview-profile-view");
    const viewCard = document.getElementById("preview-card-view");

    function updatePreview() {
        const headline =
            (
                document.getElementById("headline") as HTMLInputElement | null
            )?.value.trim() || "";
        const major =
            (
                document.getElementById("major") as HTMLInputElement | null
            )?.value.trim() || "";
        const bio =
            (
                document.getElementById("bio") as HTMLTextAreaElement | null
            )?.value.trim() || "";
        const location =
            (
                document.getElementById("location") as HTMLInputElement | null
            )?.value.trim() || "";
        const timezone =
            (
                document.getElementById("timezone") as HTMLInputElement | null
            )?.value.trim() || "";
        const websiteUrl =
            (
                document.getElementById("websiteUrl") as HTMLInputElement | null
            )?.value.trim() || "";

        // 1. Headline
        const pvHeadline = document.getElementById("pv-headline");
        const pvcHeadline = document.getElementById("pvc-headline");
        if (pvHeadline) {
            pvHeadline.textContent = headline;
            pvHeadline.classList.toggle("hidden", !headline);
        }
        if (pvcHeadline) {
            pvcHeadline.textContent = headline;
            pvcHeadline.classList.toggle("hidden", !headline);
        }

        // 1b. Major badge (profile preview + card preview)
        const pvMajorBadge = document.getElementById("pv-major-badge");
        const pvcMajorBadge = document.getElementById("pvc-major-badge");
        if (pvMajorBadge) {
            pvMajorBadge.textContent = major;
            pvMajorBadge.classList.toggle("hidden", !major);
        }
        if (pvcMajorBadge) {
            pvcMajorBadge.textContent = major;
            pvcMajorBadge.classList.toggle("hidden", !major);
        }

        // 2. Location & Timezone
        const pvLocationRow = document.getElementById("pv-location-row");
        const pvLocationItem = document.getElementById("pv-location-item");
        const pvLocationText = document.getElementById("pv-location-text");
        const pvcLocation = document.getElementById("pvc-location");
        const pvcLocationText = document.getElementById("pvc-location-text");

        if (pvLocationItem && pvLocationText) {
            pvLocationText.textContent = location;
            pvLocationItem.classList.toggle("hidden", !location);
        }
        if (pvcLocation && pvcLocationText) {
            pvcLocationText.textContent = location;
            pvcLocation.classList.toggle("hidden", !location);
        }

        const pvTzItem = document.getElementById("pv-timezone-item");
        const pvTzText = document.getElementById("pv-timezone-text");
        let localTimeFormatted = "";
        if (timezone) {
            try {
                localTimeFormatted = new Intl.DateTimeFormat("en-US", {
                    timeZone: timezone,
                    hour: "numeric",
                    minute: "2-digit",
                    timeZoneName: "short",
                }).format(new Date());
            } catch {
                localTimeFormatted = "";
            }
        }
        if (pvTzItem && pvTzText) {
            pvTzText.textContent = localTimeFormatted;
            pvTzItem.classList.toggle("hidden", !localTimeFormatted);
        }
        if (pvLocationRow) {
            pvLocationRow.classList.toggle(
                "hidden",
                !location && !localTimeFormatted,
            );
        }

        // 3. Socials
        const pvSocialsRow = document.getElementById("pv-socials-row");
        if (pvSocialsRow) {
            pvSocialsRow.innerHTML = "";
            const socialsList: Array<{ label: string; url: string }> = [];
            if (websiteUrl) {
                socialsList.push({ label: "Website", url: websiteUrl });
            }
            document
                .querySelectorAll<HTMLElement>(".social-row")
                .forEach((row) => {
                    const sel = row.querySelector<HTMLSelectElement>(
                        ".social-platform-select",
                    );
                    const inp = row.querySelector<HTMLInputElement>(
                        "input[name='social_value']",
                    );
                    if (sel && inp && inp.value.trim()) {
                        const optText =
                            sel.options[sel.selectedIndex]?.text || sel.value;
                        socialsList.push({
                            label: optText,
                            url: inp.value.trim(),
                        });
                    }
                });
            if (socialsList.length > 0) {
                pvSocialsRow.classList.remove("hidden");
                socialsList.forEach((s) => {
                    const pill = document.createElement("span");
                    pill.className =
                        "border border-foreground bg-background px-2.5 py-1 font-mono text-xs font-semibold inline-flex items-center gap-1";
                    const labelSpan = document.createElement("span");
                    labelSpan.textContent = s.label;
                    const arrowSpan = document.createElement("span");
                    arrowSpan.className =
                        "text-[10px] text-foreground/60 leading-none";
                    arrowSpan.textContent = "↗";
                    pill.append(labelSpan, arrowSpan);
                    pvSocialsRow.appendChild(pill);
                });
            } else {
                pvSocialsRow.classList.add("hidden");
            }
        }

        // 4. Bio & Custom Links
        const pvAboutSec = document.getElementById("pv-about-section");
        const pvBioCard = document.getElementById("pv-bio-card");
        const pvBioText = document.getElementById("pv-bio-text");
        const pvcBio = document.getElementById("pvc-bio");

        if (pvBioCard && pvBioText) {
            pvBioText.textContent = bio;
            pvBioCard.classList.toggle("hidden", !bio);
        }
        if (pvcBio) {
            pvcBio.textContent = bio;
            pvcBio.classList.toggle("hidden", !bio);
        }

        const pvLinksCard = document.getElementById("pv-links-card");
        const pvLinksList = document.getElementById("pv-links-list");
        let hasCustomLinks = false;
        if (pvLinksList) {
            pvLinksList.innerHTML = "";
            document
                .querySelectorAll<HTMLElement>(".custom-link-row")
                .forEach((row) => {
                    const lbl = row
                        .querySelector<HTMLInputElement>(
                            "input[name='custom_label']",
                        )
                        ?.value.trim();
                    const url = row
                        .querySelector<HTMLInputElement>(
                            "input[name='custom_url']",
                        )
                        ?.value.trim();
                    if (lbl && url) {
                        hasCustomLinks = true;
                        const a = document.createElement("span");
                        a.className =
                            "border border-foreground bg-background px-2.5 py-1 font-mono text-xs font-bold uppercase inline-flex items-center gap-1";
                        a.textContent = `${lbl} ↗`;
                        pvLinksList.appendChild(a);
                    }
                });
            if (pvLinksCard) {
                pvLinksCard.classList.toggle("hidden", !hasCustomLinks);
            }
        }
        if (pvAboutSec) {
            pvAboutSec.classList.toggle("hidden", !bio && !hasCustomLinks);
        }

        // 5. Contact Visibility (Emails & Phone)
        const checkedEmails: string[] = [];
        document
            .querySelectorAll<HTMLInputElement>(
                'input[name="visible_email"]:checked',
            )
            .forEach((cb) => {
                if (cb.value.trim()) checkedEmails.push(cb.value.trim());
            });
        const phoneCb = document.querySelector<HTMLInputElement>(
            'input[name="visible_phone"]',
        );
        const phoneVisible = phoneCb ? phoneCb.checked : false;
        const phoneVal =
            phoneCb
                ?.closest(".contact-vis-row")
                ?.querySelector("span.font-mono")
                ?.textContent?.trim() || "";

        const pvContactSec = document.getElementById("pv-contact-section");
        const pvEmailCard = document.getElementById("pv-email-card");
        const pvEmailsList = document.getElementById("pv-emails-list");
        const pvcFooterEmail = document.getElementById("pvc-footer-email");
        const pvcFooterEmailText = document.getElementById(
            "pvc-footer-email-text",
        );

        if (pvEmailsList) {
            pvEmailsList.innerHTML = "";
            if (checkedEmails.length > 0) {
                checkedEmails.forEach((em) => {
                    const emDiv = document.createElement("div");
                    emDiv.className =
                        "font-mono text-xs sm:text-sm font-semibold break-all";
                    emDiv.textContent = em;
                    pvEmailsList.appendChild(emDiv);
                });
                pvEmailCard?.classList.remove("hidden");
            } else {
                pvEmailCard?.classList.add("hidden");
            }
        }
        if (pvcFooterEmail && pvcFooterEmailText) {
            if (checkedEmails.length > 0) {
                pvcFooterEmailText.textContent = checkedEmails[0];
                pvcFooterEmail.classList.remove("hidden");
            } else {
                pvcFooterEmail.classList.add("hidden");
            }
        }

        const pvPhoneCard = document.getElementById("pv-phone-card");
        const pvPhoneText = document.getElementById("pv-phone-text");
        const pvcFooterPhone = document.getElementById("pvc-footer-phone");
        const pvcFooterPhoneText = document.getElementById(
            "pvc-footer-phone-text",
        );

        if (pvPhoneCard && pvPhoneText) {
            if (phoneVisible && phoneVal) {
                pvPhoneText.textContent = phoneVal;
                pvPhoneCard.classList.remove("hidden");
            } else {
                pvPhoneCard.classList.add("hidden");
            }
        }
        if (pvcFooterPhone && pvcFooterPhoneText) {
            if (phoneVisible && phoneVal) {
                pvcFooterPhoneText.textContent = phoneVal;
                pvcFooterPhone.classList.remove("hidden");
            } else {
                pvcFooterPhone.classList.add("hidden");
            }
        }

        const hasAnyContact =
            checkedEmails.length > 0 || (phoneVisible && !!phoneVal);
        if (pvContactSec) {
            const hasDiscord = !!pvContactSec.querySelector(".text-ph-purple");
            pvContactSec.classList.toggle(
                "hidden",
                !hasAnyContact && !hasDiscord,
            );
        }
        const pvcFooter = document.getElementById("pvc-footer");
        if (pvcFooter) {
            const hasDiscord = !!pvcFooter.querySelector(".text-ph-purple");
            pvcFooter.classList.toggle("hidden", !hasAnyContact && !hasDiscord);
        }
    }

    if (tabBtnProfile && tabBtnCard && viewProfile && viewCard) {
        tabBtnProfile.addEventListener("click", () => {
            tabBtnProfile.className =
                "preview-tab-btn border-t border-x border-foreground bg-ph-yellow text-ph-black px-3.5 py-1.5 font-mono text-xs font-bold uppercase cursor-pointer";
            tabBtnCard.className =
                "preview-tab-btn border-t border-x border-foreground/40 bg-muted/40 text-foreground/70 hover:text-foreground px-3.5 py-1.5 font-mono text-xs font-bold uppercase cursor-pointer";
            viewProfile.classList.remove("hidden");
            viewCard.classList.add("hidden");
        });

        tabBtnCard.addEventListener("click", () => {
            tabBtnCard.className =
                "preview-tab-btn border-t border-x border-foreground bg-ph-yellow text-ph-black px-3.5 py-1.5 font-mono text-xs font-bold uppercase cursor-pointer";
            tabBtnProfile.className =
                "preview-tab-btn border-t border-x border-foreground/40 bg-muted/40 text-foreground/70 hover:text-foreground px-3.5 py-1.5 font-mono text-xs font-bold uppercase cursor-pointer";
            viewCard.classList.remove("hidden");
            viewProfile.classList.add("hidden");
        });
    }

    if (openPreviewBtn && previewDialog) {
        openPreviewBtn.addEventListener("click", () => {
            updatePreview();
            previewDialog.showModal();
        });

        // Light-dismiss fallback for older browsers / Safari
        if (!("closedBy" in HTMLDialogElement.prototype)) {
            const outside = (e: MouseEvent, dialog: HTMLDialogElement) => {
                const r = dialog.getBoundingClientRect();
                return (
                    e.clientX < r.left ||
                    e.clientX > r.right ||
                    e.clientY < r.top ||
                    e.clientY > r.bottom
                );
            };
            let pressedOutside = false;
            previewDialog.addEventListener("pointerdown", (e) => {
                pressedOutside = outside(e, previewDialog);
            });
            previewDialog.addEventListener("pointerup", (e) => {
                if (pressedOutside && outside(e, previewDialog)) {
                    previewDialog.close();
                }
            });
        }
    }

    if (previewSaveBtn && form) {
        previewSaveBtn.addEventListener("click", () => {
            previewDialog?.close();
            form.requestSubmit();
        });
    }
</script>
