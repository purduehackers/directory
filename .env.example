# Purdue Hackers ID provider base URL
ID_BASE=http://localhost:5173

# Directory application OAuth client credentials registered in ID
CLIENT_ID=directory-service
CLIENT_SECRET=directory-secret

# Public origin of Directory site
PUBLIC_URL=http://localhost:4321

# Secret for signing member session cookies
SESSION_SECRET=super-secret-key-at-least-32-chars-long-ph-directory

# Secret for verifying webhooks from ID (optional)
WEBHOOK_SECRET=directory-webhook-secret

# Database configuration (LibSQL/SQLite)
# Local SQLite default: file:./data/directory.db
TURSO_DATABASE_URL=file:./data/directory.db
TURSO_AUTH_TOKEN=

# Discord Bot token for resolving user handles from Discord IDs (optional)
DISCORD_BOT_TOKEN=
# Discord Guild ID for bulk member preloading on cold start (optional)
DISCORD_GUILD_ID=
# Cache TTL for resolved Discord profiles in milliseconds (default: 7 days)
DISCORD_CACHE_TTL_MS=604800000
